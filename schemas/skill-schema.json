{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/schemas/skill-schema.json",
  "title": "AgentEngineerSkillPackage",
  "description": "Package shape for a feature skill. Each skill is a folder: SKILL.md (contract), schema.json (run fields), templates/*.md (the only allowed write-up).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contract", "ioSchema", "templates"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^feature-[a-z0-9-]+$",
      "description": "Stable skill id. Must match the folder name under skills/."
    },
    "contract": {
      "type": "string",
      "const": "SKILL.md"
    },
    "ioSchema": {
      "type": "string",
      "const": "schema.json"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "pattern": "^templates/[A-Za-z0-9._/-]+\\.md$"
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "writesUnder": {
      "type": "string",
      "const": "docs/features/<feature-name>/"
    }
  }
}
