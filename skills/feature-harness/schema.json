{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/skills/feature-harness/schema.json",
  "title": "FeatureHarnessIO",
  "description": "Run developer, reviewer, verifier for one feature specification. One verify-fail retry. Classify later feedback.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "type": "string", "minLength": 1 },
        "whatToBuildPath": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "featureName",
        "whatWasRunPath",
        "retriesUsed",
        "stoppedBecause"
      ],
      "properties": {
        "skillId": { "type": "string", "const": "feature-harness" },
        "featureName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "whatWasRunPath": {
          "type": "string",
          "pattern": "^docs/features/[a-z0-9-]+/what-was-run.md$"
        },
        "retriesUsed": { "type": "integer", "enum": [0, 1] },
        "stoppedBecause": {
          "type": "string",
          "enum": [
            "pass",
            "verify-fail",
            "cancelled",
            "missing-spec",
            "empty-kitchen",
            "review-blocked-specifier",
            "classify-unsure"
          ]
        }
      }
    }
  }
}
