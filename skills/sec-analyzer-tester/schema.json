{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/skills/sec-analyzer-tester/schema.json",
  "title": "SecAnalyzerTesterIO",
  "description": "Input and output contract for the sec-analyzer-tester skill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemUnderReview"],
      "properties": {
        "systemUnderReview": {
          "type": "string",
          "minLength": 1
        },
        "featureDirectory": { "type": "string" },
        "specPath": { "type": "string" },
        "knownTrustBoundaries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scannerFindings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "status",
        "adaptiveMode",
        "trustBoundaries",
        "findings",
        "artifacts"
      ],
      "properties": {
        "skillId": {
          "type": "string",
          "const": "sec-analyzer-tester"
        },
        "status": {
          "type": "string",
          "enum": [
            "modeled",
            "mitigations-proposed",
            "awaiting-risk-acceptance",
            "tests-generated",
            "complete"
          ]
        },
        "adaptiveMode": {
          "type": "string",
          "enum": ["automated-tests", "manual-qa", "mixed"]
        },
        "trustBoundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "from", "to"],
            "properties": {
              "id": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "data": { "type": "string" },
              "control": { "type": "string" }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "stride", "severity", "description", "disposition"],
            "properties": {
              "id": { "type": "string", "pattern": "^SEC-[0-9]{3}$" },
              "boundaryId": { "type": "string" },
              "stride": {
                "type": "string",
                "enum": [
                  "spoofing",
                  "tampering",
                  "repudiation",
                  "information-disclosure",
                  "denial-of-service",
                  "elevation-of-privilege"
                ]
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "description": { "type": "string" },
              "disposition": {
                "type": "string",
                "enum": ["fix", "accept-risk", "out-of-scope"]
              },
              "owner": { "type": "string" },
              "testIds": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "tests": {
          "type": "object",
          "properties": {
            "framework": { "type": "string" },
            "command": { "type": "string" },
            "paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "manualChecklistPath": { "type": "string" }
          }
        },
        "gate": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": ["not-required", "pending", "approved", "rejected"]
            },
            "token": { "type": "string" }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "properties": {
              "path": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": [
                  "threat-model",
                  "mitigation-plan",
                  "automated-test-plan",
                  "manual-qa-checklist",
                  "test-source"
                ]
              }
            }
          }
        }
      }
    }
  }
}
