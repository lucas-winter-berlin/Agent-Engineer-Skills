{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/skills/feature-code-reviewer/schema.json",
  "title": "FeatureCodeReviewerIO",
  "description": "Strict code review and safe internal refactor. Verdict fail until must-fix is gone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "type": "string", "minLength": 1 },
        "whatToBuildPath": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "featureName",
        "whatWasReviewedPath",
        "verdict"
      ],
      "properties": {
        "skillId": { "type": "string", "const": "feature-code-reviewer" },
        "featureName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "whatWasReviewedPath": {
          "type": "string",
          "pattern": "^(agent-engineer-skills|docs/features)/[a-z0-9-]+/what-was-reviewed.md$"
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail"]
        }
      }
    }
  }
}
