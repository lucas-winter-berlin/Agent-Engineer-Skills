{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/skills/feature-specifier/schema.json",
  "title": "FeatureSpecifierIO",
  "description": "Input and output for feature-specifier: one what-to-build file the developer must follow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "type": "string", "minLength": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "featureName",
        "status",
        "whatToBuildPath",
        "inScope",
        "outOfScope",
        "lockedDecisions",
        "doneWhen"
      ],
      "properties": {
        "skillId": { "type": "string", "const": "feature-specifier" },
        "featureName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["awaiting-questions", "draft", "ready-for-developer"]
        },
        "whatToBuildPath": {
          "type": "string",
          "pattern": "^(agent-engineer-skills|docs/features)/[a-z0-9-]+/what-to-build.md$"
        },
        "inScope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "outOfScope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "lockedDecisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["decision", "lock"],
            "properties": {
              "question": { "type": "string" },
              "decision": { "type": "string" },
              "lock": {
                "type": "string",
                "description": "What the developer must do (template Spec column). Not the specification file name."
              },
              "source": {
                "type": "string",
                "enum": ["user", "repo", "locked-default"]
              }
            }
          }
        },
        "doneWhen": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
