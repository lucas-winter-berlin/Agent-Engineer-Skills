{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/skills/feature-tester/schema.json",
  "title": "FeatureTesterIO",
  "description": "Write tests from what-to-build.md and run this repo's unit, integration, and security tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "type": "string", "minLength": 1 },
        "whatToBuildPath": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "featureName",
        "whatWasVerifiedPath",
        "verdict"
      ],
      "properties": {
        "skillId": { "type": "string", "const": "feature-tester" },
        "featureName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "whatWasVerifiedPath": {
          "type": "string",
          "pattern": "^(agent-engineer-skills|docs/features)/[a-z0-9-]+/what-was-verified.md$"
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail", "not-run"]
        }
      }
    }
  }
}
