{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/skills/feature-developer/schema.json",
  "title": "FeatureDeveloperIO",
  "description": "Implement what-to-build.md: branch, structure, code, what-was-implemented.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "type": "string", "minLength": 1 },
        "whatToBuildPath": {
          "type": "string",
          "description": "Path to what-to-build.md when known."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "featureName",
        "branch",
        "whatWasImplementedPath",
        "status"
      ],
      "properties": {
        "skillId": { "type": "string", "const": "feature-developer" },
        "featureName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "branch": { "type": "string" },
        "whatWasImplementedPath": {
          "type": "string",
          "pattern": "^(agent-engineer-skills|docs/features)/[a-z0-9-]+/what-was-implemented.md$"
        },
        "status": {
          "type": "string",
          "enum": ["implemented", "blocked-need-concept", "blocked-need-ask"]
        }
      }
    }
  }
}
