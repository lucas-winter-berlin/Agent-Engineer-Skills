{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/skills/mvp-builder/pitch-to-spec/schema.json",
  "title": "PitchToSpecIO",
  "description": "Stub I/O for pitch-to-spec. The skill must not write a specification until the contract is implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "type": "string", "minLength": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "status"],
      "properties": {
        "skillId": { "type": "string", "const": "pitch-to-spec" },
        "status": { "type": "string", "const": "not-implemented" }
      }
    }
  }
}
