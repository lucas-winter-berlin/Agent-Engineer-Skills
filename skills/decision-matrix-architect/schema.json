{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineer-skills.dev/skills/decision-matrix-architect/schema.json",
  "title": "DecisionMatrixArchitectIO",
  "description": "Input and output contract for the decision-matrix-architect skill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionQuestion"],
      "properties": {
        "decisionQuestion": {
          "type": "string",
          "minLength": 8
        },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hardConstraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "specPath": { "type": "string" },
        "documentAfterTheFact": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "decisionQuestion",
        "status",
        "hardConstraints",
        "criteria",
        "options",
        "ranking",
        "artifacts"
      ],
      "properties": {
        "skillId": {
          "type": "string",
          "const": "decision-matrix-architect"
        },
        "decisionQuestion": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "rejected", "deprecated", "superseded", "tie"]
        },
        "hardConstraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "statement"],
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "name", "weight", "scoreOneMeaning", "scoreFiveMeaning"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "scoreOneMeaning": { "type": "string" },
              "scoreFiveMeaning": { "type": "string" }
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "name", "constraintResults", "scores", "pros", "cons", "edgeCases"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "eligible": { "type": "boolean" },
              "constraintResults": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["constraintId", "result"],
                  "properties": {
                    "constraintId": { "type": "string" },
                    "result": {
                      "type": "string",
                      "enum": ["pass", "fail"]
                    },
                    "evidence": { "type": "string" }
                  }
                }
              },
              "scores": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["criterionId", "score"],
                  "properties": {
                    "criterionId": { "type": "string" },
                    "score": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "rationale": { "type": "string" }
                  }
                }
              },
              "weightedTotal": { "type": "number" },
              "pros": {
                "type": "array",
                "items": { "type": "string" }
              },
              "cons": {
                "type": "array",
                "items": { "type": "string" }
              },
              "edgeCases": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "ranking": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["optionId", "rank", "eligible"],
            "properties": {
              "optionId": { "type": "string" },
              "rank": { "type": "integer", "minimum": 1 },
              "eligible": { "type": "boolean" },
              "weightedTotal": { "type": "number" }
            }
          }
        },
        "recommendation": {
          "type": "object",
          "properties": {
            "optionId": { "type": "string" },
            "summary": { "type": "string" },
            "tie": { "type": "boolean" }
          }
        },
        "gate": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": ["pending", "approved", "rejected"]
            },
            "token": { "type": "string" }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "properties": {
              "path": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": ["decision-matrix", "adr"]
              }
            }
          }
        }
      }
    }
  }
}
